save_chem_shifts_calc_type
   _Chem_shifts_calc_type.Sf_category                      chem_shifts_calc_type
   _Chem_shifts_calc_type.Sf_framecode                     chem_shifts_calc_type
   _Chem_shifts_calc_type.Entry_ID                         bmst000097
