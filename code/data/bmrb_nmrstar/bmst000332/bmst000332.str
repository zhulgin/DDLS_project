   _Chem_shifts_calc_type.Calculation_level                'Density Functional Theory'
   _Chem_shifts_calc_type.Quantum_mechanical_method        GIAO
   _Chem_shifts_calc_type.Quantum_mechanical_theory_level  B3LYP
