	################################

save_chem_shift_reference
   _Chem_shift_reference.Sf_category   chem_shift_reference
   _Chem_shift_reference.Sf_framecode  chem_shift_reference
   _Chem_shift_reference.Entry_ID      bmse000580
   _Chem_shift_reference.ID            1

   loop_
      _Chem_shift_ref.Atom_type
      _Chem_shift_ref.Atom_isotope_number
      _Chem_shift_ref.Mol_common_name
      _Chem_shift_ref.Atom_group
      _Chem_shift_ref.Chem_shift_units
      _Chem_shift_ref.Chem_shift_val
      _Chem_shift_ref.Ref_method
      _Chem_shift_ref.Ref_type
      _Chem_shift_ref.Indirect_shift_ratio
      _Chem_shift_ref.Entry_ID
      _Chem_shift_ref.Chem_shift_reference_ID

     H   1    DSS   'methyl protons'   ppm   0.00   internal   direct     1.000000000   bmse000580   1    
     C   13   DSS   'methyl protons'   ppm   0.00   ?          indirect   0.251449530   bmse000580   1    

   stop_

save_
