      _Experiment.NMR_spectrometer_label
      _Experiment.Entry_ID
      _Experiment.Experiment_list_ID

     1   '2D J-resolved 1H'   yes   1   $sample_1   isotropic   1   $sample_conditions_1   1   $Bruker_700   bmse000809   1    
     2   '2D [1H,13C]-HSQC'   yes   1   $sample_1   isotropic   1   $sample_conditions_1   1   $Bruker_700   bmse000809   1    
     3   '1D 1H, NOESY'       yes   1   $sample_1   isotropic   1   $sample_conditions_1   1   $Bruker_700   bmse000809   1    

   stop_

   loop_
